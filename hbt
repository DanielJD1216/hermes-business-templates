#!/usr/bin/env bash
# hbt: Historical Creator installer, retained for existing installations.
# New customer onboarding starts at README.md, not this launcher.
# Legacy operations only, after a separate impact review:
#   ./hbt setup creator
#   ./hbt install creator --dry-run
#   ./hbt connect creator cto      (save one bot's Slack tokens)
#   ./hbt check creator            (find drift between the bots, with the fix for each gap)
#   ./hbt status creator | ./hbt update creator | ./hbt uninstall creator
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Inspect global arguments without changing what Python receives. Never run the
# native launcher here: some Hermes launchers bootstrap on their first invocation.
hermes="${HBT_HERMES-hermes}"
explicit_hermes="${HBT_HERMES+x}"
command_name=""
args=("$@")
for ((i=0; i<${#args[@]}; i++)); do
  case "${args[i]}" in
    --hermes)
      ((i+=1))
      hermes="${args[i]-}"
      explicit_hermes=x
      ;;
    --hermes=*) hermes="${args[i]#*=}"; explicit_hermes=x ;;
    -v|--verbose) ;;
    *) command_name="${args[i]}"; break ;;
  esac
done

prerequisite_help() {
  printf 'hbt: %s\n' "$1" >&2
  if [[ "$command_name" == setup ]]; then
    printf '%s\n' 'Documentation: https://hermes-agent.nousresearch.com/docs/getting-started/installation/' >&2
    if [[ -t 0 ]]; then
      printf '%s\n' 'hbt will not download, install, modify the host or continue setup.' >&2
      printf '%s' 'Display official owner-run installation/repair instructions only? [y/N] ' >&2
      answer=""
      if IFS= read -r answer; then
        case "$answer" in
          [yY]|[yY][eE][sS])
            printf '%s\n' \
              'Review the official instructions above. On Linux/WSL, the owner can separately run:' \
              '  curl -fsSL https://hermes-agent.nousresearch.com/install.sh | bash' \
              'That installer can download dependencies and change your environment.' \
              'Keep provider login in native secure setup, never in chat.' \
              'After native setup or repair, reload your shell if needed and rerun ./hbt setup creator.' >&2
            ;;
        esac
      fi
    fi
    printf '%s\n' 'hbt: prerequisites unresolved; setup not completed' >&2
  fi
  exit 1
}

hb="$(command -v -- "$hermes" 2>/dev/null || true)"
if [[ -z "$hb" || ! -x "$hb" ]]; then
  if [[ -n "$explicit_hermes" ]]; then
    prerequisite_help 'The explicit Hermes override is not executable. Correct --hermes or HBT_HERMES; no fallback was used.'
  elif [[ "$command_name" == setup ]]; then
    prerequisite_help 'Hermes was not found on PATH.'
  fi
fi

usable_python() {
  command -v -- "$1" >/dev/null 2>&1 &&
    PYTHONDONTWRITEBYTECODE=1 "$1" -c 'import yaml, ruamel.yaml' >/dev/null 2>&1
}

find_python() {
  if [[ "${HBT_PYTHON+x}" ]]; then
    usable_python "$HBT_PYTHON" || return 1
    printf '%s\n' "$HBT_PYTHON"; return
  fi
  # Hermes's own Python has PyYAML and ruamel, which the installer needs.
  local venv c
  if [[ -n "$hb" ]]; then
    venv="$(grep -oE '/[^"]*/venv/bin/hermes' "$hb" 2>/dev/null | head -1 || true)"
    [[ -z "$venv" ]] && venv="$(readlink -f "$hb")"
    c="$(dirname "$venv")/python"
    if usable_python "$c"; then printf '%s\n' "$c"; return; fi
  fi
  for c in "$HOME/.hermes/hermes-agent/venv/bin/python" python3; do
    if usable_python "$c"; then printf '%s\n' "$c"; return; fi
  done
  return 1
}

if ! python="$(find_python)"; then
  if [[ "${HBT_PYTHON+x}" ]]; then
    prerequisite_help 'HBT_PYTHON is not usable or cannot import PyYAML and ruamel.yaml. Correct the explicit override; no fallback was used.'
  fi
  prerequisite_help 'No usable Python with PyYAML and ruamel.yaml was found. If Hermes exists, repair its runtime or set HBT_PYTHON.'
fi
exec "$python" "$here/installer/hbt.py" "$@"
